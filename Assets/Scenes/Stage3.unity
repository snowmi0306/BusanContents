      value: 
      objectReference: {fileID: 4541870877151443678, guid: 53f875dce4adf1d41a63cb3916be6ab7, type: 3}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: letterHandoffAnimator
      value: 
      objectReference: {fileID: 742859386}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[0].text
      value: "\uB07C\uB8E9!...\uB07C\uB8E9 (\uAF2C\uB9C8\uC57C! \uC5EC\uAE30 \uD3B8\uC9C0\uC654\uC5B4!)"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[1].text
      value: "\uC6B0\uC640\uC544! \uD3B8\uC9C0\uBC30\uB2EC\uBD80 \uAC08\uB9E4\uAE30\uB2E4!
        \uC774\uAC70 \uB0B4 \uD3B8\uC9C0\uC57C?"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[2].text
      value: "\uB07C\uB8E9! (\uB9DE\uC544! \uC774\uAC70\uBC1B\uC544!) "
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[3].text
      value: "\uACE0\uB9C8\uC6CC \uB07C\uB8E9\uC544~! \uC5EC\uAE30\uAE4C\uC9C0 \uC624\uB294\uB370
        \uC548\uD798\uB4E4\uC5C8\uC5B4?"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[4].text
      value: "\uB07C\uB8E8\uB8E9! \uB07C\uB8E9...! (\uD798\uB4E4\uC5C8\uC9C0\uB9CC...
        \uC7AC\uBC0C\uB294 \uD558\uB8E8\uC600\uC5B4 \uADFC\uB370 \uB0B4 \uC774\uB984\uC740
        \uB07C\uB8E9\uC774\uAC00 \uC544\uB2C8\uC57C...!)"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[5].text
      value: "\uD788\uD788, \uBB34\uC2A8 \uB9D0\uC778\uC9C0 \uD558\uB098\uB3C4 \uBAA8\uB974\uACA0\uC9C0\uB9CC...
        \uC870\uC2EC\uD788 \uAC00!"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[1].speaker
