      objectReference: {fileID: 992654042}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: npcPortraitSprite
      value: 
      objectReference: {fileID: 5179013720677170087, guid: 8cf9a323cba2e4d49b3af117c72870dd, type: 3}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueController
      value: 
      objectReference: {fileID: 742859384}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dandiPortraitSprite
      value: 
      objectReference: {fileID: 4541870877151443678, guid: 53f875dce4adf1d41a63cb3916be6ab7, type: 3}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: letterHandoffAnimator
      value: 
      objectReference: {fileID: 742859386}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[0].text
      value: "\uB07C\uB8E9..!\uB07C\uB8E8\uB8E9! (\uD560\uC544\uBC84\uC9C0! \uD3B8\uC9C0\uC654\uC5B4\uC694!)"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[1].text
      value: "\uC5B4\uB77C? \uBA38\uAF2C? \uAC08\uB9E4\uAE30\uAC00 \uC9C0\uAE08 \uB098\uD55C\uD14C
        \uC8FC\uB465\uC774\uB97C \uB0B4\uBBF8\uB294 \uAE30\uAC00?"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[2].text
      value: "\uB07C\uB8E9, \uB07C\uB8E9! (\uC8FC\uB465\uC774\uAC00 \uC544\uB2C8\uB77C
        \uD3B8\uC9C0\uB77C\uB2C8\uAE50\uC694! \uC5BC\uB978 \uBC1B\uC73C\uC138\uC694!) "
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[3].text
      value: "...\uC544\uC774\uACE0 \uB9C8, \uC9C4\uC9DC \uD3B8\uC9C0\uB124? \uC694\uC0C8
        \uC138\uC0C1\uC774 \uC88B\uC544\uC9C0\uAC00 \uAC08\uB9E4\uAE30\uAC00 \uC6B0\uD3B8\uBC30\uB2EC\uBD80\uB3C4
        \uD558\uB098? \uC5B4\uC9F8 \uC774\uB9AC \uAE30\uD2B9\uD55C \uC9D3\uC744 \uD558\uB178."
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[4].text
      value: "\uB07C\uB8E8\uB8E9 \uCE74\uC9C0 \uB9D0\uACE0 \uC77C\uB8E8 \uC640\uBD10\uB77C.
