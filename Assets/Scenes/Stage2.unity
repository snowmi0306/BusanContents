      propertyPath: dialogueLines.Array.data[0].text
      value: "\uB4DC\uB514\uC5B4 \uBAA9\uC801\uC9C0\uC5D0 \uB3C4\uCC29\uD588\uC5B4!"
      objectReference: {fileID: 0}
    - target: {fileID: 8939016824696179771, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[1].text
      value: "\uC640\uC918\uC11C \uACE0\uB9C8\uC6CC. \uC774 \uD3B8\uC9C0\uB97C \uAE30\uB2E4\uB9AC\uACE0
