      value: "\uAC08\uB9E4\uAE30\uAC00 \uC640\uC774\uB9AC \uC6B0\uB178? \uC5B4\uB77C?
        \uBD80\uB9AC\uC5D0 \uBB3C\uACE0 \uC788\uB294\uAC70 \uC774\uAC70 \uB0B4 \uC774\uB984
        \uC801\uD78C \uD3B8\uC9C0 \uC544\uC774\uAC00?"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[2].text
      value: "\uB07C\uB8E9, \uB07C\uB8E9! (\uB9DE\uC544\uC694! \uD3B8\uC9C0 \uBC1B\uC73C\uC138\uC694!) "
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[3].text
      value: "\uD558\uD558\uD558! \uAC08\uB9E4\uAE30\uAC00 \uC6B0\uD3B8\uBC30\uB2EC
        \uD574\uC8FC\uB294\uAC70\uB294 \uB0B4 \uC0B4\uB2E4\uC0B4\uB2E4 \uCCA8 \uBCF4\uB124!
        \uB2C8 \uC5B5\uC218\uB85C \uB611\uB611\uD558\uB2E4!"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[4].text
      value: "\uC544\uC774\uACE0 \uADC0\uC5EC\uC6CC\uB77C, \uB2F4\uC5D0 \uC624\uBA74
        \uB9DB\uC788\uB294 \uBE75\uC774\uB77C\uB3C4 \uAD6C\uC6CC\uC8FC\uAED8!"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[5].text
      value: "\"\uB07C\uB8E9~\" (\uBE75\uC774\uC694?! \uAF2D \uB2E4\uC74C\uC5D0 \uC624\uACA0\uC2B5\uB2C8\uB2E4!)"
      objectReference: {fileID: 0}
    - target: {fileID: 4110524559377693115, guid: 22aaee9341ed24945a98538a8389beba, type: 3}
      propertyPath: dialogueLines.Array.data[1].speakerName
      value: "\uC544\uC8FC\uBA38\uB2C8"
      objectReference: {fileID: 0}
