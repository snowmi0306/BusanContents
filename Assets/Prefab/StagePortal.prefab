  m_Script: {fileID: 11500000, guid: 3b2bbf2ea8fcb37429a08bc8cbbcedab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StageGoal
  nextSceneName: Stage2_
  transitionDelay: 1.5
  transitionPanel: {fileID: 0}
  disablePlayerControl: 1
  loadDelayAfterDialogue: 0.5
  requireLetters: 0
  lettersToDeliver: 0
  consumeDeliveredLetters: 0
  playLetterHandoff: 1
  letterHandoffAnimator: {fileID: 0}
  npcHandoffTarget: {fileID: 2854160724973237125}
  useDialogueBeforeClear: 1
  dialogueController: {fileID: 0}
  dialogueLines:
  - speaker: 0
    speakerName: "\uB2E8\uB514"
    text: "\uB07C\uB8E9..!\uB07C\uB8E8\uB8E9! (\uD560\uC544\uBC84\uC9C0! \uD3B8\uC9C0\uC654\uC5B4\uC694!)"
  - speaker: 1
    speakerName: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC5B4\uB77C? \uBA38\uAF2C? \uAC08\uB9E4\uAE30\uAC00 \uC9C0\uAE08 \uB098\uD55C\uD14C
      \uC8FC\uB465\uC774\uB97C \uB0B4\uBBF8\uB294 \uAE30\uAC00?"
  - speaker: 0
    speakerName: "\uB2E8\uB514"
    text: "\uB07C\uB8E9, \uB07C\uB8E9! (\uC8FC\uB465\uC774\uAC00 \uC544\uB2C8\uB77C
      \uD3B8\uC9C0\uB77C\uB2C8\uAE50\uC694! \uC5BC\uB978 \uBC1B\uC73C\uC138\uC694!) "
  - speaker: 1
    speakerName: "\uD560\uC544\uBC84\uC9C0"
    text: "...\uC544\uC774\uACE0 \uB9C8, \uC9C4\uC9DC \uD3B8\uC9C0\uB124? \uC694\uC0C8
      \uC138\uC0C1\uC774 \uC88B\uC544\uC9C0\uAC00 \uAC08\uB9E4\uAE30\uAC00 \uC6B0\uD3B8\uBC30\uB2EC\uBD80\uB3C4
      \uD558\uB098? \uC5B4\uC9F8 \uC774\uB9AC \uAE30\uD2B9\uD55C \uC9D3\uC744 \uD558\uB178."
  - speaker: 1
    speakerName: "\uD560\uC544\uBC84\uC9C0"
    text: "\uB07C\uB8E8\uB8E9 \uCE74\uC9C0 \uB9D0\uACE0 \uC77C\uB8E8 \uC640\uBD10\uB77C.
      \uD560\uBC30\uAC00 \uBA78\uCE58\uB77C\uB3C4 \uD55C \uB9C8\uB9AC \uC8FC\uAE4C?"
  - speaker: 0
    speakerName: "\uB2E8\uB514"
    text: "\"\uB07C\uB8E8\uB8E8\uB8E9!\" (\uAC10\uC0AC\uD558\uC9C0\uB9CC, \uBE68\uB9AC
      \uB2E4\uB978 \uC9D1\uC5D0\uB3C4 \uAC00\uBD10\uC57C\uD574\uC694!)"
  dandiPortraitSprite: {fileID: 4541870877151443678, guid: 53f875dce4adf1d41a63cb3916be6ab7, type: 3}
  npcPortraitSprite: {fileID: 2787827694813933597, guid: 789c6b48b2c857d40bee4989ffb36c19, type: 3}
  requireInteractKey: 0
  interactKey: 101
  interactHint: {fileID: 0}
